{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["global"],
  "properties": {
    "global": {
      "type": "object",
      "required": ["domain", "ingressClassName", "tls"],
      "properties": {
        "domain": { "type": "string", "minLength": 3 },
        "ingressClassName": { "type": "string" },
        "tls": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "clusterIssuer": { "type": "string" }
          }
        }
      }
    },
    "traefik": {
      "type": "object",
      "properties": {
        "configureTimeouts": { "type": "boolean" }
      }
    },
    "store": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "wordpress": {
          "type": "object",
          "properties": {
            "scheme": { "enum": ["http", "https"] },
            "image": {
              "type": "object",
              "properties": {
                "repository": { "type": "string", "minLength": 1 },
                "tag": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
