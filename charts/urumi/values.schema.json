{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["global"],
  "definitions": {
    "mcpServer": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 }
          }
        },
        "secretEnv": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["secret", "key"],
            "properties": { "secret": { "type": "string" }, "key": { "type": "string" } }
          }
        }
      }
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "required": ["domain", "ingressClassName", "tls"],
      "properties": {
        "domain": { "type": "string", "minLength": 3 },
        "scheme": { "enum": ["http", "https"] },
        "ingressClassName": { "type": "string" },
        "logLevel": { "enum": ["trace", "debug", "info", "warn", "error"] },
        "tls": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "clusterIssuer": { "type": "string" }
          }
        }
      }
    },
    "traefik": {
      "type": "object",
      "properties": {
        "configureTimeouts": { "type": "boolean" }
      }
    },
    "woo-mcp": { "$ref": "#/definitions/mcpServer" },
    "fx-mcp": { "$ref": "#/definitions/mcpServer" },
    "store": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "wordpress": {
          "type": "object",
          "properties": {
            "image": {
              "type": "object",
              "properties": {
                "repository": { "type": "string", "minLength": 1 },
                "tag": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
