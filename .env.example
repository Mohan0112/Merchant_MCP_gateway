# =====================================================================
# Ahjin MCP Gateway: values you provide
# ---------------------------------------------------------------------
# Paste each value right after "=" with no quotes and no spaces.
# This file is git-ignored. Never commit it, and don't paste these values into chat.
# scripts/secrets.mjs reads this file and creates the Kubernetes Secrets.
# Random secrets (database passwords, encryption key, API-key pepper, WordPress salts)
# are generated automatically, so they aren't listed here.
# =====================================================================

# ---------- Chat agent LLM (needed by Task 15) ----------
# Groq (free): https://console.groq.com/keys -> "Create API Key"
GROQ_API_KEY=
# Optional fallback. Google AI Studio (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------- GitHub repo, CI and images (needed by Task 1) ----------
# Your GitHub username (used for the repo and ghcr.io image names)
GITHUB_USERNAME=
# Repo to create (public)
GITHUB_REPO=Merchant_MCP_gateway

# ---------- Third MCP server: GitHub remote MCP (needed by Task 8) ----------
# 1. Create a small public demo repo, e.g. ahjin-demo-issues
# 2. Create a fine-grained token: https://github.com/settings/personal-access-tokens/new
#    Repository access: "Only select repositories" -> the demo repo
#    Permissions: Issues = Read and write (Metadata = Read is added automatically)
GITHUB_MCP_DEMO_REPO=
GITHUB_MCP_PAT=

# ---------- Dashboard first admin (needed by Task 10) ----------
# The email you'll log in with. Leave the password empty to have one generated
# (the secrets script prints it once).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- WooCommerce store admin (needed by Task 5) ----------
# wp-admin login. Leave the password empty to have one generated.
WP_ADMIN_USER=storeadmin
WP_ADMIN_EMAIL=
WP_ADMIN_PASSWORD=

# ---------- VPS / production (OPTIONAL: deferred to Phase 2 Task 31; leave blank for now) ----------
# Oracle Cloud Always Free: https://www.oracle.com/cloud/free/
# Create an "Ampere A1" instance with Ubuntu 24.04, then fill in:
VPS_PUBLIC_IP=
VPS_SSH_USER=ubuntu
# Full path to the private key you downloaded when creating the instance
VPS_SSH_KEY_PATH=
# DuckDNS (free, sign in with GitHub or Google): https://www.duckdns.org
# Subdomain only, e.g. "ahjin-mohan" for ahjin-mohan.duckdns.org
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=
# Email for Let's Encrypt certificate notices
LETSENCRYPT_EMAIL=
